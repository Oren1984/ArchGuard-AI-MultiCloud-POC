# ArchGuard-AI-MultiCloud-POC — environment configuration template
# Copy to .env and fill in real values for local use.
# Do NOT commit a real .env file. Only placeholders belong here.

# --- Application ---
APP_ENV=local
APP_NAME=archguard-ai-multicloud-poc
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=archguard
POSTGRES_USER=archguard
POSTGRES_PASSWORD=changeme-local-only
DATABASE_URL=postgresql+psycopg://archguard:changeme-local-only@db:5432/archguard

# --- AI Provider selection ---
# "mock" (default, no credentials required) or "openai_compatible"
AI_PROVIDER=mock
AI_MODEL_NAME=archguard-mock-v1
AI_PROMPT_VERSION=v1

# Only required when AI_PROVIDER=openai_compatible. Left blank by default.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# --- Evaluation gate thresholds ---
EVAL_MIN_CONFIDENCE=0.55
EVAL_CONSISTENCY_RUNS=2

# --- Governance ---
# Simple demo identity model: header-based actor identification (see docs/SECURITY.md).
APPROVAL_HEADER_NAME=X-ArchGuard-Actor
KILL_SWITCH_DEFAULT_STATE=inactive

# --- Observability ---
METRICS_ENABLED=true
CORRELATION_ID_HEADER=X-Correlation-ID
